# Copy to .env.

# ── Local address (keep HOST_IP, WEB_PORT and HTTPS the same as in devhub-api/.env) ──
# "localhost", or this machine's LAN IP (see `ipconfig`, e.g. 192.168.1.20) to open the app from
# other devices. localhost keeps working either way.
HOST_IP=localhost
API_PORT=4000
WEB_PORT=3000
# Empty = automatic: HTTPS on for a LAN IP, off for localhost.
HTTPS=

# ── Hosted (Vercel) ──
# Where the Next.js server calls the API. Defaults to http://localhost:${API_PORT}.
# API_INTERNAL_URL=
# Same value as devhub-api's INTERNAL_API_SECRET.
# INTERNAL_API_SECRET=
# The API's public URL, for Socket.IO. Locally leave it unset: the socket goes through this app.
# NEXT_PUBLIC_WS_URL=
