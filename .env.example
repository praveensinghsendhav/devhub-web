# Copy to .env.

# ── Local address (keep HOST_IP, WEB_PORT and HTTPS the same as in devhub-api/.env) ──
# "localhost", or this machine's LAN IP (see `ipconfig`, e.g. 192.168.1.20) to open the app from
# other devices. localhost keeps working either way.
HOST_IP=localhost
API_PORT=4000
WEB_PORT=3000
# Empty = automatic: HTTPS on for a LAN IP, off for localhost.
HTTPS=

# ── Hosted (Vercel) ──
# The API's public URL; the browser calls it directly. Defaults to http://localhost:${API_PORT}.
# NEXT_PUBLIC_API_URL=
# Socket.IO URL, only if it differs from NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_WS_URL=
